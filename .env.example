# ==============================================================================
# PLURIBUS CSR STATUTORY EVIDENCE VAULT — PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SECURITY & SESSION ENCRYPTION (MANDATORY FOR PRODUCTION)
# ------------------------------------------------------------------------------
# High-entropy 32+ byte string used to sign HS256 JWT auth session tokens.
# Generate via: openssl rand -base64 32
JWT_SECRET=replace_with_a_secure_random_32_byte_string_for_production!

# The public origin of your deployed application (used for CORS and cookies).
APP_BASE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. EVIDENCE REPOSITORY & DIGITAL ASSET MANAGEMENT (CLOUDINARY)
# ------------------------------------------------------------------------------
# Used for storing tamper-evident geotagged photos, video reels, and signed PDFs.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=pluribus-demo
CLOUDINARY_CLOUD_NAME=pluribus-demo
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET_IMAGE=pluribus_field_signed
CLOUDINARY_UPLOAD_PRESET_VIDEO=pluribus_video_signed
CLOUDINARY_NOTIFICATION_URL=https://api.pluribus.app/webhooks/cloudinary

# ------------------------------------------------------------------------------
# 3. POSTGRES DATABASE WITH POSTGIS & PGVECTOR (SUPABASE)
# ------------------------------------------------------------------------------
# Required for persistent production storage, spatial geofencing, and vector search.
# If left blank, the app falls back to in-memory state.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# 4. GROUNDED AI, VISION TAGGING & VECTOR EMBEDDINGS
# ------------------------------------------------------------------------------
# Required for text-embedding-3-small (1536d semantic search) and AI vision checks.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
EMBEDDINGS_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ------------------------------------------------------------------------------
# 5. ASYNC BACKGROUND WORKERS (INNGEST) - OPTIONAL
# ------------------------------------------------------------------------------
# Needed if running production background workers for daily missing evidence alerts.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ------------------------------------------------------------------------------
# 6. INTERNAL SERVICES (VERCEL SERVICE BINDINGS)
# ------------------------------------------------------------------------------
# Automatically injected by Vercel when running with vercel dev or in production.
# For standalone local development, defaults to http://localhost:4000.
RENDER_SERVICE_URL=http://localhost:4000

