{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "render": {
      "root": "apps/render",
      "framework": "express"
    },
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "render",
          "format": "url",
          "env": "RENDER_SERVICE_URL"
        }
      ]
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
